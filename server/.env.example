# ============================================================================
# SafeSeat SMS Server — Environment Variables
# ============================================================================
# All secrets live ONLY in Vercel environment variables.
# Never commit real credentials to git.
# ============================================================================

# Set to "true" during development/testing. SMS will NOT be sent.
# The endpoint will log what *would* have been sent instead.
TEST_MODE=true

# Infobip credentials (from portal.infobip.com → Developers → API Keys)
# Use the personalized Infobip API base URL shown in your account, e.g. xxxxx.api.infobip.com
INFOBIP_API_BASE_URL=xxxxx.api.infobip.com
INFOBIP_API_KEY=REDACTED
# Infobip free-trial sender. Change only after your account has an approved sender.
INFOBIP_SENDER=ServiceSMS

# Firebase Admin service account JSON (single-line, from Firebase Console → Project Settings → Service Accounts)
FIREBASE_SERVICE_ACCOUNT=REDACTED
